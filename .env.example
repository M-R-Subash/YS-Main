# ==============================================================================
# ENVIRONMENT & RUNTIME
# ==============================================================================
NODE_ENV=development
PORT=3001

# ==============================================================================
# APPLICATION & BRANDING METADATA (Publicly Accessible)
# ==============================================================================
NEXT_PUBLIC_APP_NAME="YS Innovations"
NEXT_PUBLIC_APP_DESCRIPTION="Innovate Today, Lead Tomorrow — Enterprise Software & Cloud Solutions"
NEXT_PUBLIC_APP_VERSION="1.0.0"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# ==============================================================================
# CMS & BACKEND API ENDPOINTS
# ==============================================================================
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ==============================================================================
# DATABASE (PostgreSQL / Supabase / Neon / RDS)
# ==============================================================================
# Local Postgres example:
DATABASE_URL="postgres://postgres:postgres@localhost:5432/zoro_cms?sslmode=disable"
DIRECT_URL="postgres://postgres:postgres@localhost:5432/zoro_cms?sslmode=disable"

# Production Supabase Pooler example (Port 6543):
# DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# ==============================================================================
# RATE LIMITING & THROTTLING
# ==============================================================================
THROTTLE_TTL=60
THROTTLE_LIMIT=1000

# ==============================================================================
# SECURITY & CRYPTOGRAPHIC SECRETS
# ==============================================================================
# Shared handshake secret for iframe preview synchronization with admin.ys
PREVIEW_SECRET="your-32-byte-hex-secret-min-32-chars"

# Timing-safe token for on-demand ISR cache purging (/api/revalidate)
REVALIDATION_SECRET="your-32-byte-hex-secret-min-32-chars"
